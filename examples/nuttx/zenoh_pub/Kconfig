#
# examples/nuttx/zenoh_pub/Kconfig
#

config EXAMPLES_ZENOH_PUB
	tristate "zenoh-pico publisher example"
	default n
	depends on NET_UDP
	---help---
		Build the zenoh-pico UDP publisher as a NuttX builtin app.
		Network must be up (virtio-net provides virtual Ethernet to A53 Linux).

if EXAMPLES_ZENOH_PUB

config EXAMPLES_ZENOH_PICO_DIR
	string "Path to zenoh-pico source tree"
	default "$(TOPDIR)/../zenoh-pico"
	---help---
		Absolute or CMake-relative path to the zenoh-pico repository root.
		Defaults to a sibling directory of the NuttX tree.

config EXAMPLES_ZENOH_PUB_PROGNAME
	string "Program name"
	default "zenoh_pub"

config EXAMPLES_ZENOH_PUB_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_ZENOH_PUB_STACKSIZE
	int "Stack size (bytes)"
	default 8192

endif # EXAMPLES_ZENOH_PUB
